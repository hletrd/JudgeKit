{
  "name": "judgekit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:bash": "bash -n deploy-docker.sh && bash -n deploy.sh",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:security": "vitest run tests/unit/security",
    "db:push": "JUDGEKIT_HOST_DATABASE_URL=1 drizzle-kit push",
    "db:push:dev": "JUDGEKIT_HOST_DATABASE_URL=1 drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:check": "bash scripts/check-migration-drift.sh",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "backup:db": "bash scripts/backup-db.sh",
    "backup:verify": "bash scripts/verify-db-backup.sh",
    "db:studio": "JUDGEKIT_HOST_DATABASE_URL=1 drizzle-kit studio",
    "seed": "JUDGEKIT_HOST_DATABASE_URL=1 tsx scripts/seed.ts",
    "languages:sync": "JUDGEKIT_HOST_DATABASE_URL=1 tsx scripts/sync-language-configs.ts",
    "signature-flags:recompute": "JUDGEKIT_HOST_DATABASE_URL=1 tsx scripts/recompute-signature-flags.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:component": "vitest run --config vitest.config.component.ts",
    "test:harness": "vitest run --config vitest.config.harness.ts",
    "test:e2e": "JUDGEKIT_HOST_DATABASE_URL=1 playwright test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/typography": "^0.5.20",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "highlight.js": "^11.12.0",
    "isomorphic-dompurify": "^4.6.0",
    "jose": "^6.2.14",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.64.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "p-limit": "^7.3.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pretendard": "^1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "thememirror": "^2.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "hono": "^4.13.14",
    "esbuild": "^0.28.2",
    "katex": "$katex",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
